// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git_panel": {
    "file_icons": true,
    "tree_view": true
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "agent": {
    "sandbox_permissions": {
      "warn_ntfs_grants": false
    },
    "default_profile": "write",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-5",
      "enable_thinking": true,
      "effort": "high"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "tab_size": 2,
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "auto_update": false,
  "default_open_behavior": "new_window",
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "base_keymap": "Zed",
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "format_on_save": "on",
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": ["golangci-lint", "run", "--output.json.path", "stdout", "--show-stats=false", "--output.text.path="],
      },
    },
    "helm": {
      "settings": {
        "helm-ls": {
          "logLevel": "info",
          "yamlls": {
            "enabled": true,
          },
        },
      },
    },
    "terraform-ls": {
      "initialization_options": {
        "experimentalFeatures": {
          "prefillRequiredFields": true,
        },
      },
    },
  },
  "languages": {
    "Go": {
      "formatter": {
        "external": {
          "command": "golangci-lint",
          "arguments": ["fmt", "--stdin"],
        },
      },
      "language_servers": ["...", "golangci-lint"],
    },
    "Markdown": {
      "formatter": {
        "language_server": {
          "name": "rumdl",
        },
      },
      "format_on_save": "on",
    },
    "Shell Script": {
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}", "--indent", "2"],
        },
      },
    },
    "YAML": {
      "formatter": {
        "external": {
          "command": "yamlfmt",
          "arguments": ["-quiet", "-in"],
        },
      },
    },
  },
  "file_types": {
    "GitHub Actions": [".github/workflows/*.yml", ".github/workflows/*.yaml"],
    "Helm": ["helmfile.yaml", "helmfile.yml", "Chart.yaml", "Chart.yml", "Chart.lock", "requirements.yaml", "requirements.yml", "**/templates/**/*.tpl", "**/templates/**/*.yaml", "**/templates/**/*.yml", "**/helmfile.d/**/*.yaml", "**/helmfile.d/**/*.yml"],
    "OpenTofu": [],
    "OpenTofu Vars": [],
  },
}
